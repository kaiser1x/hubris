# HUBRIS — environment template. Copy to .env and fill in values.
# Root .env is for local dev / turbo. Next.js also auto-loads apps/web/.env.local.

# --- API (apps/api, Hono) ---
# Port the Hono API listens on. Must match HUBRIS_API_BASE / NEXT_PUBLIC_API_BASE below.
# Defaults to 3001 to avoid clashing with Next.js dev on 3000.
PORT=3001

# GitHub personal access token (optional but recommended).
# Used for api.github.com metadata calls. Without it you hit strict unauthenticated rate limits.
GITHUB_TOKEN=

# --- Web frontend (apps/web, Next.js) ---
# Server-side: Next.js API route proxy -> Hono API.
HUBRIS_API_BASE=http://localhost:3001
# Client-side (must be prefixed NEXT_PUBLIC_ to reach the browser).
NEXT_PUBLIC_API_BASE=http://localhost:3001

# --- Upcoming: Nebius Token Factory / AI Cloud (sandbox worker) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_SANDBOX_URL=


# Nebius project + model selection (Token Factory / AI Cloud).
NEBIUS_PROJECT_ID=
NEBIUS_MODEL=

# Local PostgreSQL (see docker-compose.yml). Used for jobs, twin graphs, case files.
DATABASE_URL=

# Sandbox checkout transfer guards (POST /api/checkout). Conservative
# defaults apply when unset: max tracked files and max tarball bytes.
HUBRIS_MAX_REPO_FILES=
HUBRIS_MAX_REPO_BYTES=

# Sandbox execution limits (all runs) and install timing (POST /api/install).
# Defaults when unset: 120s command timeout, 150s poll budget, 1MiB recorded
# output per stream, 300s install timeout with 330s poll budget.
HUBRIS_SANDBOX_TIMEOUT=
HUBRIS_SANDBOX_WAIT_MS=
HUBRIS_MAX_OUTPUT_BYTES=
HUBRIS_MAX_LAYER_BYTES=
HUBRIS_INSTALL_TIMEOUT=
HUBRIS_INSTALL_WAIT_MS=
