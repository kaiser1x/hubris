# HUBRIS — environment template. Copy to .env and fill in values.
# Root .env is for local dev / turbo. Next.js also auto-loads apps/web/.env.local.

# --- API (apps/api, Hono) ---
# Port the Hono API listens on. Must match HUBRIS_API_BASE / NEXT_PUBLIC_API_BASE below.
# Defaults to 3001 to avoid clashing with Next.js dev on 3000.
PORT=3001

# GitHub personal access token.
# Metadata calls (optional but recommended): without it you hit strict unauthenticated rate limits.
# SHIP (POST /api/ship) REQUIRES it: it pushes a hubris/* branch and opens a pull request, so the
# token needs write access (contents + pull requests) to the target repository ONLY. Prefer a
# fine-grained token scoped to specific repositories. It is read from the environment at request
# time, never persisted, and redacted from errors and logs.
GITHUB_TOKEN=

# --- Web frontend (apps/web, Next.js) ---
# Server-side: Next.js API route proxy -> Hono API.
HUBRIS_API_BASE=http://localhost:3001
# Client-side (must be prefixed NEXT_PUBLIC_ to reach the browser).
NEXT_PUBLIC_API_BASE=http://localhost:3001

# --- Upcoming: Nebius Token Factory / AI Cloud (sandbox worker) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_SANDBOX_URL=


# Nebius project + model selection (Token Factory / AI Cloud).
NEBIUS_PROJECT_ID=
NEBIUS_MODEL=

# Local PostgreSQL (see docker-compose.yml). Used for jobs, twin graphs, case files.
DATABASE_URL=

# Sandbox checkout transfer guards (POST /api/checkout). Conservative
# defaults apply when unset: max tracked files and max tarball bytes.
HUBRIS_MAX_REPO_FILES=
HUBRIS_MAX_REPO_BYTES=

# Sandbox execution limits (all runs) and install timing (POST /api/install).
# Defaults when unset: 120s command timeout, 150s poll budget, 1MiB recorded
# output per stream, 300s install timeout with 330s poll budget.
HUBRIS_SANDBOX_TIMEOUT=
HUBRIS_SANDBOX_WAIT_MS=
HUBRIS_MAX_OUTPUT_BYTES=
HUBRIS_MAX_LAYER_BYTES=
HUBRIS_INSTALL_TIMEOUT=
HUBRIS_INSTALL_WAIT_MS=

# Repository test execution (POST /api/run-tests): install + tests in one
# disposable run. Defaults when unset: 600s command timeout, 660s poll budget.
HUBRIS_TEST_TIMEOUT=
HUBRIS_TEST_WAIT_MS=

# --- Deployment (Vercel) --------------------------------------------------
# Shared secret between the web proxies and the API. When set on the API, every
# route except /health requires header x-hubris-api-key. Set the SAME value on
# both Vercel projects. Server-side only: never prefix with NEXT_PUBLIC_.
HUBRIS_API_KEY=
# Platform function limit in seconds (match the Vercel project's Default Max
# Duration: 800 on Pro/Enterprise, 300 on Hobby). Sandbox waits and model calls
# are clamped to what remains, so a slow run is reported as TIMEOUT instead of
# being killed. Defaults to 300 on Vercel; unset locally = no clamp.
HUBRIS_FUNCTION_MAX_DURATION_S=
# Per-instance Postgres pool size (use a pooled DATABASE_URL on serverless).
HUBRIS_DB_POOL_MAX=
# Public https repository used by POST /api/diagnostics/git for its read-only
# `git ls-remote` step. Default: https://github.com/octocat/Hello-World.git
HUBRIS_GIT_PROBE_REPO=

# Public evaluator demo (web): on by default on Vercel, off locally. on|off.
HUBRIS_DEMO_MODE=
# Demo limits (API, per instance; defaults shown in apps/api/src/demo.ts).
HUBRIS_DEMO_ANALYZE_PER_HOUR=
HUBRIS_DEMO_RUNS_PER_HOUR=
HUBRIS_DEMO_MAX_CONCURRENT=
HUBRIS_DEMO_DAILY_RUNS=
